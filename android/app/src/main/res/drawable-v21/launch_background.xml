<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#121F20"
                android:endColor="#0C1516" />
        </shape>
    </item>
    <item>
        <shape>
            <size android:height="360dp" />
            <gradient
                android:centerColor="#191F24"
                android:endColor="#121F20"
                android:startColor="#1F8A93"
                android:angle="135" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
